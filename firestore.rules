rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // La licence du writer (uid == license_key) est-elle ACTIVE et liée à ce user ?
    function licenseOwns(userId) {
      return exists(/databases/$(database)/documents/licenses/$(request.auth.uid))
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.telegram_id == userId;
    }

    // (#57) Le dashboard s'authentifie avec uid == telegram_id (jamais la clé de licence) :
    // licenseOwns() ne peut donc jamais s'appliquer à sa PROPRE session, et rien ne
    // revérifiait le statut de la licence pour l'accès dashboard lui-même -- un client banni
    // gardait un accès dashboard tant que son compte Firebase Auth n'était pas explicitement
    // désactivé. license_key est poussé par le bot dans users/{userId} (donc écrit UNIQUEMENT
    // quand SA PROPRE licence est active, cf. licenseOwns ci-dessus, et l'écriture de ce
    // document est désormais réservée au bot, cf. plus bas) -- on relit cette licence pour
    // vérifier qu'elle est TOUJOURS active au moment précis de la commande.
    function licenseActiveForUser(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      let licKey = userDoc.data.license_key;
      return licKey is string
        && exists(/databases/$(database)/documents/licenses/$(licKey))
        && get(/databases/$(database)/documents/licenses/$(licKey)).data.status == 'ACTIVE';
    }

    // ── Licences ───────────────────────────────────────────────────────────
    match /licenses/{licenseKey} {
      // Le bot lit sa propre licence
      allow read: if request.auth != null && request.auth.uid == licenseKey;
      // Le bot peut écrire telegram_id ET hwid sur SA licence, mais UNIQUEMENT à la 1ère
      // inscription (champ vide) -- sinon un client actif pourrait réécrire telegram_id vers
      // l'ID d'un AUTRE client et devenir propriétaire de son compte via licenseOwns() (#30).
      allow update: if request.auth != null && request.auth.uid == licenseKey
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telegram_id'])
            && (!('telegram_id' in resource.data) || resource.data.telegram_id == null || resource.data.telegram_id == 0)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hwid'])
            && (resource.data.hwid == null || resource.data.hwid == '')
          )
        );
      // Création / suppression : Admin SDK uniquement (le bot de licence bypass les règles)
      allow create, delete: if false;
    }

    // ── Données utilisateur ────────────────────────────────────────────────
    match /users/{userId} {
      // (#57) Lecture : dashboard (ses propres données) OU bot. Écriture : bot UNIQUEMENT --
      // ce document est entièrement poussé par le bot (build_state_document) ; le dashboard ne
      // l'écrit jamais directement (il passe par commands/, cf. plus bas). Une écriture libre
      // et sans restriction de champ n'avait donc aucun usage légitime côté client et
      // permettait de falsifier ses propres données affichées (pack débloqué, solde, etc.) via
      // un appel Firestore direct (devtools/REST), en contournant totalement l'UI.
      allow read: if request.auth != null
        && (request.auth.uid == userId || licenseOwns(userId));
      allow write: if request.auth != null && licenseOwns(userId);

      // Sous-doc privé (bot_token) : bot UNIQUEMENT, jamais le dashboard
      match /private/{document=**} {
        allow read, write: if request.auth != null && licenseOwns(userId);
      }

      // Commandes : dashboard ou bot
      // (#36) Le dashboard ne peut CRÉER que des types qu'il écrit réellement (cf. App.jsx) --
      // sans cette liste blanche, rien n'empêchait un client de se déposer lui-même une
      // commande "set_allowed_channels" (réservée au bot de licence via l'Admin SDK) et de
      // s'auto-attribuer un pack complet sans payer. update/delete restent réservés au bot
      // (licenseOwns) : le dashboard ne fait que créer une commande puis lire son statut.
      // (#54) toggle_mute/toggle_drawdown/toggle_sl_suiveur/toggle_soft_sl manquaient : ces 4
      // boutons du dashboard créaient une commande refusée par cette règle (permission-denied
      // silencieux), alors que l'UI avait déjà basculé l'état visuellement -- fausse
      // impression qu'une protection de sécurité (ex: Max Drawdown) avait changé d'état.
      // (#57) La branche dashboard exige désormais licenseActiveForUser(userId), SAUF pour
      // request_stats (lecture fréquente et bénigne, pas la peine de payer 3 lectures
      // Firestore supplémentaires par appel) : un client dont la licence est bannie/expirée ne
      // peut plus déposer de commande d'action (panic/kill/close_trade/...) via le dashboard,
      // même si son compte Telegram reste actif.
      match /commands/{cmdId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || licenseOwns(userId));
        allow create: if request.auth != null
          && (
            licenseOwns(userId)
            || (
              request.auth.uid == userId
              && request.resource.data.type in
                 ['request_stats', 'update_setting', 'close_trade', 'be_trade', 'suivre', 'panic',
                  'kill', 'unlock', 'toggle_mute', 'toggle_drawdown', 'toggle_sl_suiveur', 'toggle_soft_sl']
              && (request.resource.data.type == 'request_stats' || licenseActiveForUser(userId))
            )
          );
        allow update, delete: if request.auth != null && licenseOwns(userId);
      }
    }

    // ── Événements de sécurité (écrits par le bot, relayés sur Telegram par le VPS) ──
    match /security_events/{eventId} {
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/licenses/$(request.auth.uid))
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.status == 'ACTIVE';
      allow read, update, delete: if false; // Admin SDK (VPS) uniquement
    }

    // ── (#29) Mailbox retour client : écrite par le DASHBOARD (uid == telegram_id,
    // comme users/{userId}) -- pas par le bot, donc pas le même motif que security_events. ──
    // (#38) Le cooldown 15 min n'était appliqué que côté UI (bouton désactivé) -- contournable
    // en appelant Firestore directement. Le create doit désormais, dans le MÊME batch,
    // avancer feedback_cooldown/{uid}.last_at -- lui-même limité à 1 écriture/15min par sa
    // propre règle -- ce qui rend le cooldown réellement infranchissable côté serveur.
    match /feedback/{ticketId} {
      allow create: if request.auth != null
        && request.resource.data.user_uid == request.auth.uid
        && request.resource.data.status == 'nouveau'
        && request.resource.data.ticket == null
        && request.resource.data.reply == null
        && request.resource.data.relayed == false
        && getAfter(/databases/$(database)/documents/feedback_cooldown/$(request.auth.uid)).data.last_at == request.time;
      allow read: if request.auth != null && resource.data.user_uid == request.auth.uid;
      allow update, delete: if false; // Admin SDK (VPS) uniquement (/vu, /corrige, /rep)
    }
    match /feedback_cooldown/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.last_at == request.time
        && (
          !exists(/databases/$(database)/documents/feedback_cooldown/$(uid))
          || request.time > resource.data.last_at + duration.value(15, 'm')
        );
    }
    match /counters/{counterId} {
      allow read, write: if false; // Admin SDK (VPS) uniquement
    }
  }
}
