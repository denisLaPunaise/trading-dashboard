rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // La licence du writer (uid == license_key) est-elle ACTIVE et liée à ce user ?
    function licenseOwns(userId) {
      return exists(/databases/$(database)/documents/licenses/$(request.auth.uid))
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.status == 'ACTIVE'
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.telegram_id == userId;
    }

    // ── Licences ───────────────────────────────────────────────────────────
    match /licenses/{licenseKey} {
      // Le bot lit sa propre licence
      allow read: if request.auth != null && request.auth.uid == licenseKey;
      // Le bot peut écrire telegram_id ET hwid sur SA licence, mais UNIQUEMENT à la 1ère
      // inscription (champ vide) -- sinon un client actif pourrait réécrire telegram_id vers
      // l'ID d'un AUTRE client et devenir propriétaire de son compte via licenseOwns() (#30).
      allow update: if request.auth != null && request.auth.uid == licenseKey
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['telegram_id'])
            && (!('telegram_id' in resource.data) || resource.data.telegram_id == null || resource.data.telegram_id == 0)
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hwid'])
            && (resource.data.hwid == null || resource.data.hwid == '')
          )
        );
      // Création / suppression : Admin SDK uniquement (le bot de licence bypass les règles)
      allow create, delete: if false;
    }

    // ── Données utilisateur ────────────────────────────────────────────────
    match /users/{userId} {
      // Dashboard (uid == telegram_id) OU bot (licence active liée à ce user)
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || licenseOwns(userId));

      // Sous-doc privé (bot_token) : bot UNIQUEMENT, jamais le dashboard
      match /private/{document=**} {
        allow read, write: if request.auth != null && licenseOwns(userId);
      }

      // Commandes : dashboard ou bot
      // (#36) Le dashboard ne peut CRÉER que des types qu'il écrit réellement (cf. App.jsx) --
      // sans cette liste blanche, rien n'empêchait un client de se déposer lui-même une
      // commande "set_allowed_channels" (réservée au bot de licence via l'Admin SDK) et de
      // s'auto-attribuer un pack complet sans payer. update/delete restent réservés au bot
      // (licenseOwns) : le dashboard ne fait que créer une commande puis lire son statut.
      match /commands/{cmdId} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || licenseOwns(userId));
        allow create: if request.auth != null
          && (
            licenseOwns(userId)
            || (
              request.auth.uid == userId
              && request.resource.data.type in
                 ['request_stats', 'update_setting', 'close_trade', 'be_trade', 'suivre', 'panic', 'kill', 'unlock']
            )
          );
        allow update, delete: if request.auth != null && licenseOwns(userId);
      }
    }

    // ── Événements de sécurité (écrits par le bot, relayés sur Telegram par le VPS) ──
    match /security_events/{eventId} {
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/licenses/$(request.auth.uid))
        && get(/databases/$(database)/documents/licenses/$(request.auth.uid)).data.status == 'ACTIVE';
      allow read, update, delete: if false; // Admin SDK (VPS) uniquement
    }

    // ── (#29) Mailbox retour client : écrite par le DASHBOARD (uid == telegram_id,
    // comme users/{userId}) -- pas par le bot, donc pas le même motif que security_events. ──
    match /feedback/{ticketId} {
      allow create: if request.auth != null && request.resource.data.user_uid == request.auth.uid;
      allow read: if request.auth != null && resource.data.user_uid == request.auth.uid;
      allow update, delete: if false; // Admin SDK (VPS) uniquement (/vu, relais)
    }
    match /counters/{counterId} {
      allow read, write: if false; // Admin SDK (VPS) uniquement
    }
  }
}
